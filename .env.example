# Aviator provider credentials
AVIATOR_PROVIDER_ID=
AVIATOR_PROVIDER_PUBLIC_KEY=

# Optional provider gateway override
AVIATOR_PROVIDER_BASE_URL=https://gateway.crash.aviator.studio

# Provider request timeout
AVIATOR_PROVIDER_TIMEOUT_MS=10000

# Live ingestion
# Keep disabled until an authorized round-ID source is connected.
AVIATOR_LIVE_INGESTION_ENABLED=false
AVIATOR_LIVE_INGESTION_INTERVAL_MS=5000
